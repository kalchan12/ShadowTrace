<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground Service Permissions (Android 14+ required foregroundServiceType="location") -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network / Wake Lock -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".ShadowTraceApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_dialog_map"
        android:label="ShadowTrace Service"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- Background Foreground Location Service -->
        <service
            android:name=".service.ForegroundLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- AIDL IPC Service exposed only for bound IPC communication -->
        <service
            android:name=".ipc.ShadowTraceAidlService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.shadowtrace.service.ACTION_BIND_IPC" />
            </intent-filter>
        </service>

    </application>

</manifest>
