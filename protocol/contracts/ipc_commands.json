{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IpcCommandsContract",
  "type": "object",
  "properties": {
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "return_type", "description"],
        "properties": {
          "name": { "type": "string" },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          },
          "return_type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
