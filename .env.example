# ShadowTrace Environment Configuration Example
# Copy this file to .env or your environment configuration when deploying.
# DO NOT COMMIT REAL CREDENTIALS OR SERVICE KEYS TO VERSION CONTROL.

# Backend (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key-here

# Client App Configuration
SHADOWTRACE_CLIENT_ENV=development
SHADOWTRACE_SERVICE_PACKAGE=com.shadowtrace.service

# Service App Configuration
SHADOWTRACE_SERVICE_ENV=development
SHADOWTRACE_UPDATE_INTERVAL_MS=10000
SHADOWTRACE_FASTEST_INTERVAL_MS=5000
SHADOWTRACE_MIN_DISPLACEMENT_M=5.0
